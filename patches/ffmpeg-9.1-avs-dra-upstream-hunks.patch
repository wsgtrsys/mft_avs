diff --git a/ffmpeg-9.1/libavcodec/codec_id.h b/ffmpeg-9.1/libavcodec/codec_id.h
index a4e8e30..a94664b 100644
--- a/ffmpeg-9.1/libavcodec/codec_id.h
+++ b/ffmpeg-9.1/libavcodec/codec_id.h
@@ -596,6 +596,12 @@ enum AVCodecID {
     AV_CODEC_ID_ARIB_CAPTION,
     AV_CODEC_ID_IVTV_VBI,
 
+    /* DRA (AVS audio, GB/T 20090.6), added by the ffmpeg_cavs_dra integration.
+     * New codec ids must be appended: libavcodec/version.c has static assertions on
+     * the values of ids scattered through these lists.  This is the last implicitly
+     * numbered position; the block below restarts at an explicit 0x18000. */
+    AV_CODEC_ID_DRA,
+
     /* other specific kind of codecs (generally used for attachments) */
     AV_CODEC_ID_FIRST_UNKNOWN = 0x18000,           ///< A dummy ID pointing at the start of various fake codecs.
     AV_CODEC_ID_TTF = 0x18000,
